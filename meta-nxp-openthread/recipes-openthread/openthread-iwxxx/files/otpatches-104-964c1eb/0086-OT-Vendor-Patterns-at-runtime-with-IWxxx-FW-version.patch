diff --git a/src/core/thread/vendor_info.cpp b/src/core/thread/vendor_info.cpp
index 06f154eaf..4aef7d061 100644
--- a/src/core/thread/vendor_info.cpp
+++ b/src/core/thread/vendor_info.cpp
@@ -65,6 +65,25 @@ VendorInfo::VendorInfo(Instance &aInstance)
 #endif
 }
 
+Error VendorInfo::SetVendorPatterns(const char *aName, const char *aModel, const char *aSwVersion, const char *aAppUrl)
+{
+    static uint8_t alreadySet = 0;
+    if(!alreadySet)
+    {
+        alreadySet = 1;
+        static_assert(sizeof(aName) <= sizeof(NameStringType), "VENDOR_NAME is too long");
+        static_assert(sizeof(aModel) <= sizeof(ModelStringType), "VENDOR_MODEL is too long");
+        static_assert(sizeof(aSwVersion) <= sizeof(SwVersionStringType), "VENDOR_SW_VERSION is too long");
+        static_assert(sizeof(aAppUrl) <= sizeof(AppUrlStringType), "VENDOR_APP_URL is too long");
+        if (StringCopy(mName, aName, kStringCheckUtf8Encoding)) return OT_ERROR_FAILED;
+        if (StringCopy(mModel, aModel, kStringCheckUtf8Encoding)) return OT_ERROR_FAILED;
+        if (StringCopy(mSwVersion, aSwVersion, kStringCheckUtf8Encoding)) return OT_ERROR_FAILED;
+        if (StringCopy(mAppUrl, aAppUrl, kStringCheckUtf8Encoding)) return OT_ERROR_FAILED;
+    }
+    return OT_ERROR_NONE;
+}
+
